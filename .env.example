# Local PostgreSQL container only. Set a unique local password before starting Docker.
POSTGRES_DB=procurement_slots
POSTGRES_USER=procurement_app
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Backend connection string; keep credentials only in ignored .env files.
DATABASE_URL=postgresql+psycopg://procurement_app:replace-with-a-local-development-password@localhost:5432/procurement_slots
